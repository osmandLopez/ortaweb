---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-orta.webp';

/*
 * Logotipo de la marca.
 *
 * Los dos archivos estuvieron cruzados: la marca se llamaba inicio.webp y el
 * rótulo de «Artículos de temporada» ocupaba el nombre logo-orta.webp, de modo
 * que quien importara «el logo» por su nombre acababa enseñando el rótulo de
 * temporada en el header. Ya están cada uno en su sitio: logo-orta.webp es la
 * marca, y articulos-temporada.webp el rótulo que usa src/pages/temporada.astro.
 *
 * astro:assets genera webp/avif y los tamaños según `width`, así que la página
 * no arrastra el peso del original.
 */
interface Props {
  /** Alto en pantalla; el ancho sale de la proporción 1.5:1 */
  alto?: 'sm' | 'md' | 'lg';
  prioridad?: boolean;
  class?: string;
}

const { alto = 'md', prioridad = false, class: clase = '' } = Astro.props;

// Se pide al doble del tamaño de pantalla para que se vea nítido en retina.
const MEDIDAS = {
  sm: { render: 160, clases: 'h-8 w-auto' },
  md: { render: 200, clases: 'h-10 w-auto sm:h-12' },
  lg: { render: 400, clases: 'h-20 w-auto sm:h-24' },
} as const;

const { render, clases } = MEDIDAS[alto];
---

<Image
  src={logo}
  alt="Orta Novedades"
  width={render}
  height={Math.round(render / 1.5)}
  loading={prioridad ? 'eager' : 'lazy'}
  decoding={prioridad ? 'sync' : 'async'}
  class:list={[clases, clase]}
/>
