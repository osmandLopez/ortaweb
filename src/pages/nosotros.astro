---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * Página «Nosotros». El texto sale de lo que escribió el dueño el 3 de
 * septiembre de 2026, con un solo ajuste: su borrador empezaba diciendo
 * "fabricación y venta" y dos párrafos después decía que conectan a los
 * fabricantes con el cliente. Se quedó lo segundo, que es lo que hacen.
 *
 * Faltan las fotos del local y del equipo: dijo que sí las hay. En cuanto
 * lleguen, esta página es donde van.
 */
const ANIOS = 10;

const queHacemos = [
  {
    titulo: 'Venta al por mayor',
    texto:
      'Mantenemos existencia constante y la surtimos al ritmo que la pide el negocio, sin pedidos mínimos imposibles.',
  },
  {
    titulo: 'Logística y entrega',
    texto:
      'Nos encargamos de que la mercancía salga y llegue en tiempo y forma, con paqueterías nacionales y entrega local en Monterrey.',
  },
  {
    titulo: 'Asesoría personalizada',
    texto:
      'Te ayudamos a encontrar el producto exacto que necesitas. Si no lo tenemos, casi siempre sabemos quién lo tiene.',
  },
];

const paqueterias = ['Estafeta', 'FedEx', 'Teammex', 'La Mensajería MX'];

const TARJETA =
  'flex h-full flex-col rounded-2xl border border-tinta-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-alzada';
---

<BaseLayout
  titulo="Quiénes somos"
  descripcion="Orta Novedades: diez años surtiendo productos de temporada y novedades en Monterrey, con venta al mayoreo, logística propia y asesoría."
>
  <section class="border-b border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-14 text-center lg:py-16">
      <p class="etiqueta inline-flex items-center gap-2.5 text-cielo-600">
        <span class="h-1.5 w-1.5 rounded-full bg-cielo-500" aria-hidden="true"></span>
        {ANIOS} años en Monterrey
      </p>
      <h1 class="rotulo rotulo-negro mt-5 text-4xl/tight text-tinta-900 md:text-5xl/tight">
        Quiénes somos
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-tinta-600">
        Vendemos productos de temporada. Lo que se necesita cuando toca —y un poco antes de que
        toque.
      </p>
    </div>
  </section>

  <section class="contenedor py-14 lg:py-16">
    <div class="mx-auto max-w-2xl space-y-5 text-lg leading-relaxed text-tinta-700">
      <p>
        En <strong class="text-tinta-900">Orta Novedades</strong> llevamos {ANIOS} años surtiendo una
        gama amplia de productos de calidad para el comercio y para quien compra de a poco.
      </p>
      <p>
        Conectamos a fabricantes nacionales e internacionales con nuestros clientes, y nos hacemos
        cargo de todo lo que hay en medio: la selección, el traslado, el almacén y la venta. Eso es
        lo que permite que el surtido sea constante y que lo que pides llegue cuando dijimos que iba
        a llegar.
      </p>
    </div>
  </section>

  <section class="border-t border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-14 lg:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="rotulo text-rotulo-sm text-tinta-900">Qué hacemos</h2>
      </div>

      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {queHacemos.map((q) => (
          <li class={TARJETA}>
            <h3 class="rotulo text-lg text-tinta-900">{q.titulo}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-tinta-600">{q.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contenedor py-14 lg:py-16">
    <div class="mx-auto max-w-3xl rounded-2xl border border-tinta-200 bg-white p-8 text-center shadow-sm lg:p-12">
      <p class="etiqueta text-cielo-600">Nuestra misión</p>
      <p class="mt-5 text-xl leading-relaxed text-tinta-800 lg:text-2xl">
        Ser el aliado de nuestros clientes: abastecimiento confiable, precios competitivos y un
        servicio que no deja a nadie esperando.
      </p>
    </div>
  </section>

  <section class="border-t border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-14 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="rotulo text-rotulo-sm text-tinta-900">Cómo te llega</h2>
          <p class="mt-4 leading-relaxed text-tinta-600">
            Enviamos a todo el país con paqueterías establecidas, y dentro del área metropolitana de
            Monterrey con mensajería local. También puedes recoger tu pedido en cualquiera de
            nuestras tres sucursales.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            {paqueterias.map((p) => (
              <span class="rounded-full border border-tinta-300 px-4 py-2 font-nota text-xs text-tinta-700">
                {p}
              </span>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row lg:justify-end">
          <a href="/tienda" class="btn-primario">Ver el catálogo</a>
          <a href="/contacto" class="btn-linea">Sucursales y horarios</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
