---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ApartadoTicket from '@/components/commerce/ApartadoTicket.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import { db } from '@/lib/db';

const productos = await db.listarProductos({ apartable: true });
const ejemplo = productos[0]!;
const minimo = Math.min(...productos.map((p) => p.anticipoMinimo));

const reglas = [
  ['Anticipo', `Desde ${minimo}% del precio de lista, con tarjeta.`],
  ['Plazo', 'De 6 a 12 semanas según la pieza. Aparece en tu nota.'],
  ['Abonos', 'Sin monto mínimo. Abonas en línea o en cualquier sucursal.'],
  ['Cancelación', 'Antes del vencimiento se devuelve el 80% de lo abonado.'],
];
---

<BaseLayout
  titulo="Apartados"
  descripcion="Aparta con anticipo desde el 20% y abona a tu ritmo. Sistema de apartados de Orta Novedades."
  activo="/apartados"
  fondo="mostrador"
>
  <section class="border-b border-tinta-200">
    <div class="contenedor grid items-center gap-12 py-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <p class="etiqueta text-mistico-600">Sistema de apartados</p>
        <h1 class="rotulo rotulo-negro mt-4 text-rotulo-xl text-tinta-900">
          Apártalo<br />hoy mismo
        </h1>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-tinta-600">
          Dejas anticipo, la pieza se retira de piso y queda a tu nombre. Tú abonas
          cuando puedas hasta liquidarla. Con folio, fecha y todo por escrito.
        </p>

        <dl class="mt-9 grid max-w-lg gap-x-8 gap-y-5 sm:grid-cols-2">
          {reglas.map(([titulo, texto]) => (
            <div>
              <dt class="etiqueta text-tinta-400">{titulo}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-tinta-700">{texto}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="mx-auto w-full max-w-sm lg:mx-0">
        <ApartadoTicket producto={ejemplo} abonosPagados={1} folio="ON-8QWD2P" fondo="#F7F7F8" />
      </div>
    </div>
  </section>

  <div class="contenedor py-12">
    <h2 class="rotulo text-rotulo-sm text-tinta-900">Lo que puedes apartar</h2>
    <p class="mt-2 font-nota text-[11px] text-tinta-500">{productos.length} piezas disponibles</p>

    <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
      {productos.map((p, i) => <ProductCard producto={p} loading={i < 4 ? 'eager' : 'lazy'} />)}
    </div>
  </div>
</BaseLayout>
