---
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * Página informativa de contacto. Todo lo que aparece aquí son datos reales
 * proporcionados por la tienda; no hay catálogo, promociones ni venta.
 *
 * Ojo: estas tres sucursales NO son las mismas que devuelve db.listarSucursales(),
 * que sigue sirviendo el seed de muestra (Orta Centro y Orta Plaza Norte) en el
 * inicio y en el pie. Mientras el seed no se actualice, el sitio muestra dos
 * juegos de sucursales distintos.
 */
const TELEFONO_VISIBLE = '812 065 7098';
const TELEFONO_ENLACE = '+528120657098';
const FACEBOOK = 'https://www.facebook.com/share/1DmnaHmN9G/';

/* `horas: null` significa cerrado: así el dato queda marcado en la estructura y
   no solo con un color, que sería inaccesible. */
const sucursales = [
  {
    titulo: 'Sucursal 1',
    referencia: null,
    direccion: ['Av. Zempoala #7908', 'Col. Lomas Modelo', 'Monterrey'],
    horario: [
      { dia: 'Lunes a viernes', horas: '10:00 AM – 6:00 PM' },
      { dia: 'Sábado', horas: '10:00 AM – 2:00 PM' },
      { dia: 'Domingo', horas: null },
    ],
  },
  {
    titulo: 'Sucursal 2',
    referencia: 'Plaza Tiktok, Local 16',
    direccion: ['Juan Ignacio Ramón,', 'entre Colegio Civil y Garibaldi'],
    horario: [
      { dia: 'Lunes a sábado', horas: '10:00 AM – 6:00 PM' },
      { dia: 'Domingo', horas: '10:00 AM – 3:00 PM' },
    ],
  },
  {
    titulo: 'Sucursal 3',
    referencia: null,
    direccion: ['Av. Agualeguas 211, Local D', 'Col. Santa Martha'],
    horario: [
      { dia: 'Lunes a viernes', horas: '10:00 AM – 6:00 PM' },
      { dia: 'Sábado', horas: '10:00 AM – 2:00 PM' },
      { dia: 'Domingo', horas: null },
    ],
  },
];

/* Una sola definición de tarjeta para las cinco de la página, así el borde, la
   sombra y la elevación en hover no se desincronizan entre secciones. */
const TARJETA =
  'flex h-full flex-col rounded-2xl border border-tinta-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-alzada';
---

<BaseLayout
  titulo="Contacto"
  descripcion="Teléfono, Facebook, direcciones y horarios de atención de las sucursales de Orta Novedades en Monterrey."
  activo="/contacto"
>
  <!-- Encabezado: identifica la sección, sin banner ni promoción -->
  <section class="border-b border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-14 text-center lg:py-16">
      <p class="etiqueta inline-flex items-center gap-2.5 text-cielo-600">
        <span class="h-1.5 w-1.5 rounded-full bg-cielo-500" aria-hidden="true"></span>
        Atención a clientes
      </p>
      <h1 class="rotulo rotulo-negro mt-5 text-4xl/tight text-tinta-900 md:text-5xl/tight">
        Contacto
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-tinta-600">
        ¿Tienes alguna duda? Aquí encuentras nuestros datos de contacto y
        horarios de atención.
      </p>
    </div>
  </section>

  <!-- Información general: teléfono y Facebook, las dos únicas vías reales -->
  <section class="contenedor py-14 lg:py-16">
    <h2 class="rotulo text-center text-rotulo-sm text-tinta-900">Información de contacto</h2>

    <div class="mx-auto mt-9 grid max-w-3xl gap-6 sm:grid-cols-2">
      <a
        href={`tel:${TELEFONO_ENLACE}`}
        class:list={['group hover:border-cielo-500', TARJETA]}
        aria-label={`Llamar al teléfono ${TELEFONO_VISIBLE}`}
      >
        <span class="w-fit rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.18 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </span>

        <p class="etiqueta mt-5 text-tinta-500">Teléfono</p>
        <p class="mt-2 font-nota text-2xl tabular-nums text-tinta-900 transition-colors group-hover:text-cielo-600">
          {TELEFONO_VISIBLE}
        </p>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-tinta-600">
          Contáctanos durante nuestro horario de atención.
        </p>
        <span class="etiqueta mt-5 inline-flex items-center gap-2 text-cielo-600">
          Llamar
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      <a
        href={FACEBOOK}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['group hover:border-cielo-500', TARJETA]}
        aria-label="Visitar la página de Facebook de Orta Novedades (se abre en otra pestaña)"
      >
        <span class="w-fit rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        </span>

        <p class="etiqueta mt-5 text-tinta-500">Síguenos</p>
        <p class="mt-2 text-2xl font-bold text-tinta-900 transition-colors group-hover:text-cielo-600">
          Facebook
        </p>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-tinta-600">
          Novedades y avisos de la tienda.
        </p>
        <span class="etiqueta mt-5 inline-flex items-center gap-2 text-cielo-600">
          Visitar Facebook
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- Sucursales: dirección y horario separados dentro de cada tarjeta -->
  <section class="border-t border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-14 lg:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="rotulo text-rotulo-sm text-tinta-900">Nuestras sucursales</h2>
        <p class="mt-3 text-tinta-600">Visítanos en cualquiera de nuestras sucursales.</p>
      </div>

      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sucursales.map((s) => (
          <li class={TARJETA}>
            <h3 class="rotulo text-lg text-tinta-900">{s.titulo}</h3>
            {s.referencia && (
              <p class="mt-1.5 text-sm font-bold text-cielo-600">{s.referencia}</p>
            )}

            <div class="mt-5">
              <p class="etiqueta flex items-center gap-2 text-tinta-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                Dirección
              </p>
              <address class="mt-2.5 text-sm not-italic leading-relaxed text-tinta-700">
                {s.direccion.map((linea) => <span class="block">{linea}</span>)}
              </address>
            </div>

            <div class="mt-6 flex-1 border-t border-tinta-200 pt-5">
              <p class="etiqueta flex items-center gap-2 text-tinta-500">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                Horario
              </p>
              <dl class="mt-3">
                {s.horario.map((h) => (
                  <div class="flex items-baseline justify-between gap-4 border-b border-tinta-100 py-2 last:border-0 last:pb-0">
                    <dt class="text-sm text-tinta-700">{h.dia}</dt>
                    <dd
                      class:list={[
                        'shrink-0 text-right font-nota text-xs tabular-nums',
                        h.horas ? 'text-tinta-900' : 'text-tinta-400',
                      ]}
                    >
                      {h.horas ?? 'Cerrado'}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
