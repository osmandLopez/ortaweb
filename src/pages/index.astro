---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import { Image } from 'astro:assets';
import gaia from '@/assets/gaia-rapunzel.webp';
import loteria from '@/assets/todo-para-tu-loteria.webp';
import loteriaFondo from '@/assets/todo-para-tu-loteria-fondo.webp';
import { db } from '@/lib/db';

const destacados = await db.listarProductos({ destacado: true, limite: 4 });
const temporada = await db.listarProductos({ temporada: true, limite: 4 });
const sucursales = await db.listarSucursales();

/* El arte de cada vitrina es un rótulo con fondo transparente, no una
   fotografía: por eso va en `object-contain` sobre el fondo de la tarjeta.

   Los degradados son la base: lo que se ve cuando la categoría todavía no tiene
   fondo propio, y lo que asoma en los bordes cuando sí. */
const degradados = {
  loteria: 'bg-gradient-to-br from-[#05283A] via-[#0C7EA6] to-[#3FD2E8]',
  gaia: 'bg-gradient-to-br from-[#2A0A3D] via-[#5B1E86] to-[#9B45D8]',
  temporada: 'bg-gradient-to-br from-[#7C2D12] via-[#EA580C] to-[#38BDF8]',
};

/* Las tres categorías principales del inicio. Son el primer bloque de la página:
   debajo del menú no hay nada más antes de ellas.

   `imagen` y `fondoImagen` son cosas distintas y conviene no confundirlas:
   `imagen` es el rótulo recortado que va centrado y en `object-contain`, y
   `fondoImagen` la textura que cubre la tarjeta entera por debajo, en
   `object-cover`. Hoy solo lotería tiene fondo propio; las otras dos se quedan
   con su degradado hasta que existan los archivos, y en cuanto existan basta con
   importarlos arriba y ponerlos en `fondoImagen`, que el marcado ya los pinta.
   Estirar un rótulo con transparencia a `cover` no vale como sustituto: se
   recorta por los lados y se deforma. */
const vitrinas = [
  {
    nombre: 'Todo para tu lotería',
    texto: 'Juegos, cartas y accesorios',
    href: '/tienda?q=loteria',
    imagen: loteria,
    fondoImagen: loteriaFondo,
    fondo: degradados.loteria,
  },
  {
    nombre: 'Gaia Rapunzel',
    texto: 'Productos artesanales · cuidado capilar',
    href: '/tienda?q=gaia',
    imagen: gaia,
    fondoImagen: null,
    fondo: degradados.gaia,
  },
  {
    nombre: 'Artículos de temporada',
    texto: 'Novedades para cada celebración',
    href: '/temporada',
    imagen: null,
    fondoImagen: null,
    fondo: degradados.temporada,
  },
];

/* El único ancho que se pide de cada rótulo. Compartirlo entre las tarjetas hace
   que el navegador descargue un solo archivo. */
const ANCHO_ROTULO = 760;

/* Ancho del fondo de tarjeta. Con tres a lo ancho del contenedor cada una ronda
   los 380px en escritorio, así que en pantallas de doble densidad pediríamos
   760. Justo lo que da el origen: todo-para-tu-loteria-fondo.webp mide 736 de
   ancho y ese es el techo. El adaptador redondea al alza dentro de
   `imagesConfig.sizes` de astro.config.mjs, así que acaban pidiéndose 750. */
const ANCHO_FONDO = 720;

/* La franja de confianza. Se declara aquí y no en el marcado porque son cuatro
   bloques con la misma forma: sacarlos a datos deja el HTML con una sola tarjeta
   en vez de cuatro copias que hay que mantener a la par. */
const beneficios = [
  {
    titulo: 'Pago 100% seguro',
    nota: 'Con tarjeta, Apple Pay y Google Pay',
    color: 'bg-cielo-50 text-cielo-600',
    icono: 'candado',
  },
  {
    titulo: 'Envío rápido',
    nota: 'A todo México',
    color: 'bg-emerald-50 text-emerald-600',
    icono: 'camion',
  },
  {
    titulo: 'Recoge el mismo día',
    nota: `En ${sucursales[0]?.nombre ?? 'sucursal'}`,
    color: 'bg-rose-50 text-rose-600',
    icono: 'bolsa',
  },
  {
    titulo: 'Garantía de satisfacción',
    nota: 'Tu compra protegida',
    color: 'bg-amber-50 text-amber-600',
    icono: 'escudo',
  },
];

/* Enlace al mapa construido con la dirección real de la sucursal. No se inventa
   ningún dato: es la misma cadena que ya se muestra en pantalla. */
const mapaDe = (nombre: string, direccion: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nombre}, ${direccion}`)}`;
---

<BaseLayout titulo="Novedades, temporada y regalos" activo="/">
  {/* El h1 va oculto a la vista y no por descuido: lo más grande de la pantalla
      son los rótulos de las tarjetas, y cualquiera de ellos como encabezado diría
      que el inicio trata de esa categoría. La portada es la tienda entera. */}
  <h1 class="sr-only">Orta Novedades: novedades, artículos de temporada y regalos</h1>

  <!-- NIVEL 1 · Las tres categorías, pegadas al menú: es lo primero de la página.
       Enlaces reales, no decoración: cada tarjeta es un <a> completo, así que
       funciona con teclado y el foco visible del sistema la marca sin JavaScript
       de por medio. En <640px se apilan para que el área táctil no quede
       diminuta. -->
  <section class="bg-white py-6 sm:py-8">
    <nav class="contenedor" aria-label="Categorías principales">
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {vitrinas.map((v) => (
          <li>
            <a
              href={v.href}
              class:list={[
                'group relative flex min-h-[20rem] flex-col justify-end overflow-hidden rounded-3xl shadow-lg transition duration-200 hover:-translate-y-1 hover:shadow-alzada sm:min-h-[22rem]',
                v.fondo,
              ]}
            >
              {v.fondoImagen && (
                <Image
                  src={v.fondoImagen}
                  alt=""
                  width={ANCHO_FONDO}
                  loading="eager"
                  decoding="sync"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}

              {/* Una sola capa en degradado en vez de un velo parejo: arriba deja
                  ver la ilustración casi limpia y abajo se cierra lo suficiente
                  para que el texto se lea sin ponerle una franja negra encima.
                  Va también sobre los degradados, porque el texto blanco también
                  los necesita en su parte clara. */}
              <span
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/10 transition-opacity duration-200 group-hover:opacity-90"
                aria-hidden="true"
              ></span>

              {/* La ilustración ocupa la mitad de arriba y va por encima de la
                  capa, para que no se apague. El texto se queda abajo, donde la
                  capa sí está cerrada. */}
              <span class="absolute inset-x-0 top-0 flex h-[58%] items-center justify-center p-6">
                {v.imagen ? (
                  <Image
                    src={v.imagen}
                    alt=""
                    width={ANCHO_ROTULO}
                    loading="eager"
                    decoding="sync"
                    class="max-h-full w-auto object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)] transition-transform duration-300 group-hover:scale-105"
                  />
                ) : (
                  <span class="flex items-center gap-3 text-5xl transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
                    <span class="-rotate-12">🍁</span>
                    <span class="translate-y-2 text-6xl">❄️</span>
                    <span class="rotate-12">🎃</span>
                  </span>
                )}
              </span>

              <span class="relative p-6">
                <span class="block text-lg font-bold leading-snug text-white">{v.nombre}</span>
                <span class="mt-1 block text-sm text-white/80">{v.texto}</span>
                <span class="etiqueta mt-4 inline-flex items-center gap-2 rounded-full border border-white px-4 py-1 text-white transition duration-200 group-hover:bg-white/15">
                  Ver categoría
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- NIVEL 2 · Beneficios: la franja de confianza, justo debajo de las tarjetas. -->
  <section class="border-y border-tinta-200 bg-white">
    <h2 class="sr-only">Por qué comprar en Orta Novedades</h2>
    <ul class="contenedor grid gap-6 py-8 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4">
      {beneficios.map((b) => (
        <li class="flex items-center gap-4">
          <span class:list={['shrink-0 rounded-full p-3', b.color]} aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {b.icono === 'candado' && (
                <Fragment>
                  <rect x="4.5" y="10" width="15" height="10" rx="2" />
                  <path d="M8 10V7a4 4 0 018 0v3" />
                </Fragment>
              )}
              {b.icono === 'camion' && (
                <Fragment>
                  <path d="M3 6h11v9H3z" />
                  <path d="M14 9h4l3 3v3h-7z" />
                  <circle cx="7.5" cy="18" r="1.8" />
                  <circle cx="17" cy="18" r="1.8" />
                </Fragment>
              )}
              {b.icono === 'bolsa' && (
                <Fragment>
                  <path d="M5 7h14l-1 13H6L5 7z" />
                  <path d="M9 7V5a3 3 0 016 0v2" />
                </Fragment>
              )}
              {b.icono === 'escudo' && (
                <Fragment>
                  <path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z" />
                  <path d="M9 12l2 2 4-4" />
                </Fragment>
              )}
            </svg>
          </span>
          <span>
            <span class="block text-sm font-bold text-tinta-900">{b.titulo}</span>
            <span class="block font-nota text-[11px] text-tinta-500">{b.nota}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- NIVEL 3 · Productos destacados. Reutiliza ProductCard tal cual: ya trae
       imagen, nombre, precio y botón de añadir al carrito. -->
  <section class="border-y border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="rotulo text-rotulo-sm text-tinta-900">Productos destacados</h2>
          <p class="mt-2 text-tinta-600">Descubre algunos de nuestros productos.</p>
        </div>
        <a href="/tienda" class="btn-linea">Ver todo el catálogo</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {destacados.map((p, i) => <ProductCard producto={p} loading={i < 2 ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <!-- NIVEL 4 · Temporada: la única franja dorada del sitio. -->
  <section class="bg-oro-500">
    <div class="contenedor py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="etiqueta text-oro-900">Ventas de temporada</p>
          <h2 class="rotulo rotulo-negro mt-2 text-rotulo text-tinta-900">
            Precios de calendario
          </h2>
          <p class="mt-3 max-w-md text-tinta-800">
            Rebajas que duran lo que dura la temporada. Cuando se acaba la existencia,
            se acaba el precio.
          </p>
        </div>
        <a href="/temporada" class="btn-tinta">Ver todo lo rebajado</a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {temporada.map((p) => (
          <div class="rounded-md bg-white p-3">
            <ProductCard producto={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NIVEL 5 · Sucursales. Solo datos que ya existen en la base: nombre,
       dirección y horario. El enlace al mapa se arma con esa misma dirección. -->
  <section class="contenedor py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="rotulo text-rotulo-sm text-tinta-900">Visítanos</h2>
      <p class="mt-3 text-tinta-600">Encuentra tu sucursal más cercana.</p>
    </div>

    <ul class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
      {sucursales.map((s) => (
        <li class="flex h-full flex-col rounded-2xl border border-tinta-200 bg-white p-6 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-alzada">
          <p class="etiqueta text-cielo-600">Sucursal</p>
          <h3 class="mt-3 text-lg font-bold text-tinta-900">{s.nombre}</h3>
          <p class="mt-2 text-sm text-tinta-600">{s.direccion}</p>
          <p class="mt-1 font-nota text-[11px] text-tinta-500">{s.horario}</p>
          <a
            href={mapaDe(s.nombre, s.direccion)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver la ubicación de ${s.nombre} en el mapa (se abre en otra pestaña)`}
            class="etiqueta group mt-auto inline-flex items-center gap-2 pt-6 text-cielo-600 hover:text-cielo-700"
          >
            Ver ubicación
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="mx-auto mt-6 max-w-4xl rounded-2xl border border-tinta-200 bg-papel-mostrador p-6 text-center">
      <p class="etiqueta text-cielo-600">Envíos nacionales</p>
      <p class="mt-2 text-sm text-tinta-600">
        Cotiza con tu código postal antes de pagar, sin sorpresas al final.
        Gratis a partir de $999 en envío estándar.
      </p>
    </div>
  </section>
</BaseLayout>
