---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import { Image } from 'astro:assets';
import gaia from '@/assets/gaia-rapunzel.webp';
import loteria from '@/assets/todo-para-tu-loteria.webp';
import loteriaFondo from '@/assets/todo-para-tu-loteria-fondo.webp';
import rotuloTemporada from '@/assets/articulos-temporada.webp';
import { db } from '@/lib/db';
import { descuento } from '@/lib/money';

const destacados = await db.listarProductos({ destacado: true, limite: 4 });
const sucursales = await db.listarSucursales();

/* Se piden todos los de temporada, no cuatro: el banderón de arriba anuncia la
   rebaja mayor, y calculada sobre una lista recortada anunciaría la mayor de
   esas cuatro, que no tiene por qué ser la mayor de verdad. La rejilla dorada de
   más abajo sigue enseñando cuatro, cortados aquí y no en la consulta. */
const temporadaTodos = await db.listarProductos({ temporada: true });
const temporada = temporadaTodos.slice(0, 4);
const mayorRebaja = temporadaTodos.reduce(
  (max, p) => Math.max(max, descuento(p.precio, p.precioAnterior) ?? 0),
  0,
);

/* El arte de cada vitrina es un rótulo con fondo transparente, no una
   fotografía: por eso va en `object-contain` sobre el fondo de la tarjeta.

   Los degradados se nombran aparte porque son la base: lo que se ve cuando la
   categoría no tiene fondo propio, y lo que asoma en los bordes cuando sí. */
const degradados = {
  gaia: 'bg-gradient-to-br from-[#2A0A3D] via-[#5B1E86] to-[#9B45D8]',
  loteria: 'bg-gradient-to-br from-[#05283A] via-[#0C7EA6] to-[#3FD2E8]',
};

/* Las categorías que llevan tarjeta en el inicio.

   Temporada no está aquí a propósito: ya tiene el banderón dorado de arriba, y
   darle además tarjeta ponía la misma categoría dos veces en la misma pantalla.
   Quien la busque entra por «Ver productos» del banderón.

   `imagen` y `fondoImagen` son cosas distintas y conviene no confundirlas:
   `imagen` es el rótulo recortado que va centrado y en `object-contain`, y
   `fondoImagen` la textura que cubre la tarjeta entera por debajo, en
   `object-cover`. Hoy solo lotería tiene fondo propio; Gaia se queda con su
   degradado hasta que exista el archivo, y en cuanto exista basta con
   importarlo arriba y ponerlo aquí, que el marcado ya lo pinta. Estirar un
   rótulo con transparencia a `cover` no vale como sustituto: se recorta por los
   lados y se deforma. */
const vitrinas = [
  {
    nombre: 'Todo para tu lotería',
    texto: 'Juegos, cartas y accesorios',
    href: '/tienda?q=loteria',
    imagen: loteria,
    fondoImagen: loteriaFondo,
    fondo: degradados.loteria,
  },
  {
    nombre: 'Gaia Rapunzel',
    texto: 'Productos artesanales · cuidado capilar',
    href: '/tienda?q=gaia',
    imagen: gaia,
    fondoImagen: null,
    fondo: degradados.gaia,
  },
];

/* El único ancho que se pide de cada rótulo. Compartirlo entre las tarjetas hace
   que el navegador descargue un solo archivo. */
const ANCHO_ROTULO = 760;

/* Ancho del fondo de tarjeta. Con dos tarjetas a lo ancho del contenedor cada
   una ronda los 590px en escritorio, así que en pantallas de doble densidad
   pediríamos más de mil. No los hay: todo-para-tu-loteria-fondo.webp mide 736 de
   ancho y ese es el techo. Se pide lo máximo aprovechable y se acepta que en
   retina no sea perfecto; es una textura de fondo bajo una capa oscura, no la
   foto de un producto. El adaptador redondea al alza dentro de
   `imagesConfig.sizes` de astro.config.mjs, así que acaban pidiéndose 750. */
const ANCHO_FONDO = 720;

/* Enlace al mapa construido con la dirección real de la sucursal. No se inventa
   ningún dato: es la misma cadena que ya se muestra en pantalla. */
const mapaDe = (nombre: string, direccion: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nombre}, ${direccion}`)}`;
---

<BaseLayout titulo="Novedades, temporada y regalos" activo="/">
  {/* El h1 va oculto a la vista y no por descuido: lo más grande de la pantalla
      es el rótulo de temporada, y tomarlo como encabezado de la página diría que
      el inicio trata de temporada. La portada es la tienda entera, así que el h1
      lo dice en texto y el rótulo se queda como h2 de su franja. */}
  <h1 class="sr-only">Orta Novedades: novedades, artículos de temporada y regalos</h1>

  <!-- NIVEL 1 · Temporada. El rótulo a la izquierda y la rebaja mayor a la
       derecha, que es lo que trae a la gente. -->
  <section class="bg-oro-500">
    <div class="contenedor grid items-center gap-8 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12 lg:py-14">
      <h2>
        <Image
          src={rotuloTemporada}
          alt="Artículos de temporada"
          width={760}
          height={423}
          loading="eager"
          decoding="sync"
          class="w-full max-w-xl drop-shadow-sm"
        />
      </h2>

      <div>
        {/* Sin rebajas no se enseña un −0%: se cae al texto y al botón, que
            siguen teniendo sentido por sí solos. */}
        {mayorRebaja > 0 && (
          <Fragment>
            <p class="etiqueta inline-block rounded-full bg-oro-900/15 px-3 py-1 text-oro-900">
              Hasta
            </p>
            <p class="rotulo rotulo-negro mt-2 text-rotulo-xl leading-none text-tinta-900">
              −{mayorRebaja}%
            </p>
          </Fragment>
        )}

        <p class="mt-5 max-w-md text-lg leading-relaxed text-tinta-800">
          Navidad, regreso a clases y todo lo que se mueve con el calendario.
          Cuando se acaba la existencia, se acaba el precio.
        </p>

        <a href="/temporada" class="btn-tinta mt-7">
          Ver productos
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- NIVEL 2 · Las categorías con tarjeta. Enlaces reales, no decoración: cada
       tarjeta es un <a> completo, así que funciona con teclado y el foco visible
       del sistema la marca sin JavaScript de por medio. En <640px se apilan para
       que el área táctil no quede diminuta. -->
  <section class="border-b border-tinta-200 bg-papel-mostrador py-8 sm:py-10">
    <nav class="contenedor" aria-label="Categorías principales">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5">
        {vitrinas.map((v) => (
          <li>
            <a
              href={v.href}
              class:list={[
                'group relative flex h-full flex-col overflow-hidden rounded-2xl shadow-lg transition duration-200 hover:-translate-y-1 hover:shadow-alzada',
                v.fondo,
              ]}
            >
              {v.fondoImagen && (
                <Image
                  src={v.fondoImagen}
                  alt=""
                  width={ANCHO_FONDO}
                  loading="eager"
                  decoding="sync"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}

              {/* Una sola capa en degradado en vez de un velo parejo: arriba deja
                  ver la textura casi limpia, y abajo se cierra lo suficiente para
                  que el nombre y el botón se lean sin ponerle una franja negra
                  encima. Va siempre, también sobre los degradados, porque el
                  texto blanco también los necesita en la parte clara. */}
              <span
                class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-black/10 transition-opacity duration-200 group-hover:opacity-90"
                aria-hidden="true"
              ></span>

              <span class="relative flex aspect-[16/9] items-center justify-center overflow-hidden p-5 sm:aspect-[2/1]">
                <Image
                  src={v.imagen}
                  alt=""
                  width={ANCHO_ROTULO}
                  loading="eager"
                  decoding="sync"
                  class="max-h-full w-auto object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)] transition-transform duration-300 group-hover:scale-105"
                />
              </span>

              <span class="relative px-5 pb-5">
                <span class="block text-lg font-bold leading-snug text-white">{v.nombre}</span>
                <span class="mt-1 block text-sm text-white/80">{v.texto}</span>
                <span class="etiqueta mt-4 inline-flex items-center gap-2 rounded-full border border-white/45 px-4 py-2 text-white transition duration-200 group-hover:border-white group-hover:bg-white/15">
                  Ver categoría
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>


  <!-- NIVEL 4 · Beneficios: franja de confianza entre las categorías y el catálogo -->
  <section class="border-b border-tinta-200 bg-white">
    <h2 class="sr-only">Por qué comprar en Orta Novedades</h2>
    <ul class="contenedor grid gap-6 py-8 sm:grid-cols-3 sm:gap-8">
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h11v9H3z" /><path d="M14 9h4l3 3v3h-7z" />
            <circle cx="7.5" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Envío gratis</span>
          <span class="block font-nota text-[11px] text-tinta-500">desde $999</span>
        </span>
      </li>
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 7h14l-1 13H6L5 7z" /><path d="M9 7V5a3 3 0 016 0v2" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Recoge hoy</span>
          <span class="block font-nota text-[11px] text-tinta-500">antes de las 18:00</span>
        </span>
      </li>
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4.5" y="10" width="15" height="10" rx="2" /><path d="M8 10V7a4 4 0 018 0v3" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Pago seguro</span>
          <span class="block font-nota text-[11px] text-tinta-500">Stripe · Apple &amp; Google Pay</span>
        </span>
      </li>
    </ul>
  </section>

  <!-- NIVEL 5 · Productos destacados. Reutiliza ProductCard tal cual: ya trae
       imagen, nombre, precio y botón de añadir al carrito. -->
  <section class="border-y border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="rotulo text-rotulo-sm text-tinta-900">Productos destacados</h2>
          <p class="mt-2 text-tinta-600">Descubre algunos de nuestros productos.</p>
        </div>
        <a href="/tienda" class="btn-linea">Ver todo el catálogo</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {destacados.map((p, i) => <ProductCard producto={p} loading={i < 2 ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <!-- NIVEL 6 · Temporada, los productos. La segunda franja dorada de la página:
       la de arriba anuncia la rebaja y manda a /temporada, esta enseña cuatro
       artículos concretos con su precio. Comparten color a propósito, para que
       se lean como la misma sección de la tienda. -->
  <section class="bg-oro-500">
    <div class="contenedor py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="etiqueta text-oro-900">Ventas de temporada</p>
          <h2 class="rotulo rotulo-negro mt-2 text-rotulo text-tinta-900">
            Precios de calendario
          </h2>
          <p class="mt-3 max-w-md text-tinta-800">
            Rebajas que duran lo que dura la temporada. Cuando se acaba la existencia,
            se acaba el precio.
          </p>
        </div>
        <a href="/temporada" class="btn-tinta">Ver todo lo rebajado</a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {temporada.map((p) => (
          <div class="rounded-md bg-white p-3">
            <ProductCard producto={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NIVEL 7 · Sucursales. Solo datos que ya existen en la base: nombre,
       dirección y horario. El enlace al mapa se arma con esa misma dirección. -->
  <section class="contenedor py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="rotulo text-rotulo-sm text-tinta-900">Visítanos</h2>
      <p class="mt-3 text-tinta-600">Encuentra tu sucursal más cercana.</p>
    </div>

    <ul class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
      {sucursales.map((s) => (
        <li class="flex h-full flex-col rounded-2xl border border-tinta-200 bg-white p-6 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-alzada">
          <p class="etiqueta text-cielo-600">Sucursal</p>
          <h3 class="mt-3 text-lg font-bold text-tinta-900">{s.nombre}</h3>
          <p class="mt-2 text-sm text-tinta-600">{s.direccion}</p>
          <p class="mt-1 font-nota text-[11px] text-tinta-500">{s.horario}</p>
          <a
            href={mapaDe(s.nombre, s.direccion)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver la ubicación de ${s.nombre} en el mapa (se abre en otra pestaña)`}
            class="etiqueta group mt-auto inline-flex items-center gap-2 pt-6 text-cielo-600 hover:text-cielo-700"
          >
            Ver ubicación
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="mx-auto mt-6 max-w-4xl rounded-2xl border border-tinta-200 bg-papel-mostrador p-6 text-center">
      <p class="etiqueta text-cielo-600">Envíos nacionales</p>
      <p class="mt-2 text-sm text-tinta-600">
        Cotiza con tu código postal antes de pagar, sin sorpresas al final.
        Gratis a partir de $999 en envío estándar.
      </p>
    </div>
  </section>
</BaseLayout>
