---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/commerce/ProductCard.astro';
import { Image } from 'astro:assets';
import artesanales from '@/assets/ProductosArtesanales.webp';
import loteria from '@/assets/tptl.webp';
import { db } from '@/lib/db';

const destacados = await db.listarProductos({ destacado: true, limite: 4 });
const temporada = await db.listarProductos({ temporada: true, limite: 4 });
const sucursales = await db.listarSucursales();

/* El arte de cada vitrina es un rótulo con fondo transparente, no una
   fotografía: por eso va en `object-contain` sobre su degradado.
   Temporada todavía no tiene arte propio; lleva degradado y adorno.

   Los degradados se nombran aparte porque se usan dos veces: en el mosaico del
   hero y en las tarjetas de categoría. */
const degradados = {
  gaia: 'bg-gradient-to-br from-[#2A0A3D] via-[#5B1E86] to-[#9B45D8]',
  loteria: 'bg-gradient-to-br from-[#05283A] via-[#0C7EA6] to-[#3FD2E8]',
  temporada: 'bg-gradient-to-br from-[#7C2D12] via-[#EA580C] to-[#38BDF8]',
};

/* Las tres categorías principales del inicio. Viven dentro del hero y son el
   único bloque de categorías de la página: no se repiten más abajo.
   `nombre` es la versión corta para la franja de la tarjeta; `texto` es la
   descripción que ya se usaba antes. */
const vitrinas = [
  {
    nombre: 'Gaia Rapunzel',
    texto: 'Productos artesanales · cuidado capilar',
    href: '/tienda?q=gaia',
    imagen: artesanales,
    fondo: degradados.gaia,
  },
  {
    nombre: 'Todo para tu lotería',
    texto: 'Juegos, cartas y accesorios',
    href: '/tienda?q=loteria',
    imagen: loteria,
    fondo: degradados.loteria,
  },
  {
    nombre: 'Artículos de temporada',
    texto: 'Novedades para cada celebración',
    href: '/temporada',
    imagen: null,
    fondo: degradados.temporada,
  },
];

/* El único ancho que se pide de cada rótulo. Compartirlo entre el mosaico del
   hero y las tarjetas hace que el navegador descargue un solo archivo. */
const ANCHO_ROTULO = 760;

/* Enlace al mapa construido con la dirección real de la sucursal. No se inventa
   ningún dato: es la misma cadena que ya se muestra en pantalla. */
const mapaDe = (nombre: string, direccion: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${nombre}, ${direccion}`)}`;
---

<BaseLayout titulo="Novedades, temporada y regalos" activo="/">
  <!-- NIVELES 1-3 · HERO: mensaje y CTA a la izquierda, las tres categorías
       principales a la derecha. Son enlaces reales y son el único bloque de
       categorías de la página: no se repiten más abajo. -->
  <section class="border-b border-tinta-200 bg-papel-mostrador">
    <div class="contenedor grid items-center gap-10 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:py-14">
      <div>
        <p class="etiqueta inline-flex items-center gap-2.5 text-tinta-500">
          <span class="h-1.5 w-1.5 rounded-full bg-cielo-500" aria-hidden="true"></span>
          Mostrador abierto · {sucursales.length} sucursales
        </p>

        <!-- El interlineado va pegado a cada tamaño (text-4xl/tight): si se pone
             suelto con `leading-tight`, la variante lg:text-6xl vive dentro de un
             media query posterior y vuelve a imponer su propio line-height. -->
        <h1 class="rotulo rotulo-negro mt-5 text-4xl/tight text-tinta-900 md:text-5xl/tight lg:text-6xl/tight">
          Llévatelo hoy<br />
          o te lo <span class="text-cielo-500">enviamos</span><br />
          a casa
        </h1>

        <p class="mt-5 max-w-md text-lg leading-relaxed text-tinta-600">
          Compra en línea y recoge en sucursal el mismo día.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/tienda" class="btn-primario">Ver el catálogo</a>
          <a href="/temporada" class="btn-linea">Ventas de temporada</a>
        </div>
      </div>

      <!-- Las tres categorías principales: enlaces reales, no decoración.
           Cada tarjeta es un <a> completo, así que funciona con teclado y el
           foco visible del sistema la marca sin JavaScript de por medio.
           En <640px se apilan para que el área táctil no quede diminuta. -->
      <nav aria-label="Categorías principales">
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
          <li class="sm:col-span-2">
            <a
              href={vitrinas[0].href}
              class:list={[
                'group flex h-full flex-col overflow-hidden rounded-2xl shadow-lg transition duration-200 hover:-translate-y-1 hover:shadow-alzada',
                vitrinas[0].fondo,
              ]}
            >
              <span class="relative flex aspect-[16/10] items-center justify-center overflow-hidden p-5 sm:aspect-[12/5]">
                <Image
                  src={artesanales}
                  alt=""
                  width={ANCHO_ROTULO}
                  loading="eager"
                  decoding="sync"
                  class="max-h-full w-auto object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)] transition-transform duration-300 group-hover:scale-105"
                />
                <span class="absolute inset-0 bg-black/0 transition-colors duration-200 group-hover:bg-black/15" aria-hidden="true"></span>
              </span>
              <span class="border-t border-white/15 bg-black/30 px-4 py-2.5">
                <span class="block text-sm font-bold text-white">{vitrinas[0].nombre}</span>
                <span class="mt-0.5 block text-xs text-white/75">{vitrinas[0].texto}</span>
                <span class="etiqueta mt-2.5 inline-flex items-center gap-1.5 text-white">
                  Ver categoría
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </span>
            </a>
          </li>

          {vitrinas.slice(1).map((v) => (
            <li>
              <a
                href={v.href}
                class:list={[
                  'group flex h-full flex-col overflow-hidden rounded-2xl shadow-lg transition duration-200 hover:-translate-y-1 hover:shadow-alzada',
                  v.fondo,
                ]}
              >
                <span class="relative flex aspect-[16/9] items-center justify-center overflow-hidden p-4 sm:aspect-auto sm:min-h-[7rem] sm:flex-1">
                  {v.imagen ? (
                    <Image
                      src={v.imagen}
                      alt=""
                      width={ANCHO_ROTULO}
                      loading="eager"
                      decoding="sync"
                      class="max-h-full w-auto object-contain drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)] transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <span class="flex items-center gap-2 text-4xl transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
                      <span class="-rotate-12">🍁</span>
                      <span class="translate-y-2 text-5xl">❄️</span>
                      <span class="rotate-12">🎃</span>
                    </span>
                  )}
                  <span class="absolute inset-0 bg-black/0 transition-colors duration-200 group-hover:bg-black/15" aria-hidden="true"></span>
                </span>
                <span class="border-t border-white/15 bg-black/30 px-4 py-2.5">
                  <span class="block text-sm font-bold leading-snug text-white">{v.nombre}</span>
                  <span class="mt-0.5 block text-xs text-white/75">{v.texto}</span>
                  <span class="etiqueta mt-2.5 inline-flex items-center gap-1.5 text-white">
                    Ver categoría
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
                      <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- NIVEL 4 · Beneficios: franja de confianza entre las categorías y el catálogo -->
  <section class="border-b border-tinta-200 bg-white">
    <h2 class="sr-only">Por qué comprar en Orta Novedades</h2>
    <ul class="contenedor grid gap-6 py-8 sm:grid-cols-3 sm:gap-8">
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h11v9H3z" /><path d="M14 9h4l3 3v3h-7z" />
            <circle cx="7.5" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Envío gratis</span>
          <span class="block font-nota text-[11px] text-tinta-500">desde $999</span>
        </span>
      </li>
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 7h14l-1 13H6L5 7z" /><path d="M9 7V5a3 3 0 016 0v2" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Recoge hoy</span>
          <span class="block font-nota text-[11px] text-tinta-500">antes de las 18:00</span>
        </span>
      </li>
      <li class="flex items-center gap-4">
        <span class="shrink-0 rounded-full bg-cielo-50 p-3 text-cielo-600" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4.5" y="10" width="15" height="10" rx="2" /><path d="M8 10V7a4 4 0 018 0v3" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-bold text-tinta-900">Pago seguro</span>
          <span class="block font-nota text-[11px] text-tinta-500">Stripe · Apple &amp; Google Pay</span>
        </span>
      </li>
    </ul>
  </section>

  <!-- NIVEL 5 · Productos destacados. Reutiliza ProductCard tal cual: ya trae
       imagen, nombre, precio y botón de añadir al carrito. -->
  <section class="border-y border-tinta-200 bg-papel-mostrador">
    <div class="contenedor py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="rotulo text-rotulo-sm text-tinta-900">Productos destacados</h2>
          <p class="mt-2 text-tinta-600">Descubre algunos de nuestros productos.</p>
        </div>
        <a href="/tienda" class="btn-linea">Ver todo el catálogo</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {destacados.map((p, i) => <ProductCard producto={p} loading={i < 2 ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <!-- Temporada: la única franja dorada del sitio -->
  <section class="bg-oro-500">
    <div class="contenedor py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="etiqueta text-oro-900">Ventas de temporada</p>
          <h2 class="rotulo rotulo-negro mt-2 text-rotulo text-tinta-900">
            Precios de calendario
          </h2>
          <p class="mt-3 max-w-md text-tinta-800">
            Rebajas que duran lo que dura la temporada. Cuando se acaba la existencia,
            se acaba el precio.
          </p>
        </div>
        <a href="/temporada" class="btn-tinta">Ver todo lo rebajado</a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
        {temporada.map((p) => (
          <div class="rounded-md bg-white p-3">
            <ProductCard producto={p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NIVEL 7 · Sucursales. Solo datos que ya existen en la base: nombre,
       dirección y horario. El enlace al mapa se arma con esa misma dirección. -->
  <section class="contenedor py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="rotulo text-rotulo-sm text-tinta-900">Visítanos</h2>
      <p class="mt-3 text-tinta-600">Encuentra tu sucursal más cercana.</p>
    </div>

    <ul class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
      {sucursales.map((s) => (
        <li class="flex h-full flex-col rounded-2xl border border-tinta-200 bg-white p-6 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-alzada">
          <p class="etiqueta text-cielo-600">Sucursal</p>
          <h3 class="mt-3 text-lg font-bold text-tinta-900">{s.nombre}</h3>
          <p class="mt-2 text-sm text-tinta-600">{s.direccion}</p>
          <p class="mt-1 font-nota text-[11px] text-tinta-500">{s.horario}</p>
          <a
            href={mapaDe(s.nombre, s.direccion)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver la ubicación de ${s.nombre} en el mapa (se abre en otra pestaña)`}
            class="etiqueta group mt-auto inline-flex items-center gap-2 pt-6 text-cielo-600 hover:text-cielo-700"
          >
            Ver ubicación
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="mx-auto mt-6 max-w-4xl rounded-2xl border border-tinta-200 bg-papel-mostrador p-6 text-center">
      <p class="etiqueta text-cielo-600">Envíos nacionales</p>
      <p class="mt-2 text-sm text-tinta-600">
        Cotiza con tu código postal antes de pagar, sin sorpresas al final.
        Gratis a partir de $999 en envío estándar.
      </p>
    </div>
  </section>
</BaseLayout>
