---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FormularioEntrar from '@/components/islands/FormularioEntrar';

// Si ya hay sesión, no tiene sentido pedirla otra vez.
if (Astro.locals.usuario) {
  return Astro.redirect(Astro.locals.usuario.rol === 'admin' ? '/admin' : '/cuenta', 302);
}

const destinoCrudo = Astro.url.searchParams.get('destino') ?? '/cuenta';
// Solo rutas internas: un destino con host propio sería un redirect abierto.
const destino = destinoCrudo.startsWith('/') && !destinoCrudo.startsWith('//')
  ? destinoCrudo
  : '/cuenta';
---

<BaseLayout titulo="Entrar" fondo="mostrador">
  <div class="contenedor py-16">
    <div class="mx-auto max-w-md">
      <h1 class="rotulo rotulo-negro text-rotulo text-tinta-900">Tu cuenta</h1>
      <p class="mt-3 text-tinta-600">
        Guarda tu historial, sigue tus apartados y ten tus direcciones a la mano.
        Para comprar no hace falta: el checkout funciona como invitado.
      </p>

      <div class="mt-8">
        <FormularioEntrar client:load destino={destino} />
      </div>
    </div>
  </div>
</BaseLayout>
